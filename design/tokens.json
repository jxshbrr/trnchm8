      "tight": {
        "$type": "number",
        "$value": 1.1,
        "$description": "Display and page titles."
      },
      "snug": {
        "$type": "number",
        "$value": 1.35,
        "$description": "UI text, tooltips, toasts, captions."
      },
      "normal": {
        "$type": "number",
        "$value": 1.45,
        "$description": "Rows, bubbles, short paragraphs."
      },
      "relaxed": {
        "$type": "number",
        "$value": 1.55,
        "$description": "M8 messages, descriptions, mobile journal text."
      },
      "prose": {
        "$type": "number",
