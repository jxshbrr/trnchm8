  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "Manrope",
          "system-ui",
          "sans-serif"
        ],
        "$description": "The UI typeface. Rounded geometric sans, used everywhere except display headlines."
      },
      "display": {
        "$type": "fontFamily",
        "$value": [
          "Instrument Serif",
          "Georgia",
          "serif"
        ],
        "$description": "Display serif, weight 400, roman and italic. Landing headlines and recap or share card titles only. Never in app UI, numbers or buttons."
      }
    },
    "weight": {
      "medium": {
        "$type": "fontWeight",
        "$value": 500,
        "$description": "Long-form text: journal entries, M8 messages."
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600,
        "$description": "Secondary text, meta, descriptions."
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700,
        "$description": "Labels, tags, captions."
      },
      "heavy": {
        "$type": "fontWeight",
        "$value": 800,
        "$description": "Headings, numbers, buttons, nav. The most used weight."
      }
    },
    "numeric": {
      "$type": "string",
      "$value": "tabular-nums",
      "$description": "font-variant-numeric on every root. Numbers never jitter."
    },
    "lineHeight": {
      "none": {
        "$type": "number",
