    "tgNote": {
      "fill": "orange",
      "maxH": 420,
      "size": 24,
      "text": "Inside Telegram we don't control bubbles, colors or fonts (each user's Telegram theme does). What we design: M8's words, the inline buttons under messages, and the images M8 sends (charts, recap cards). So chat chrome here is neutral; the brand lives in the avatar and the images.",
      "w": 340,
      "x": 2820,
      "y": 6000
    },
