    "dcNote": {
      "fill": "orange",
      "maxH": 560,
      "size": 24,
      "text": "On Discord we get real UI: embeds (the journal card with your accent stripe), buttons, a voice picker menu, slash commands (/start, /ask, /voice) and replies only you can see. M8 still lives in a DM, and the charts and recap card are the same images as on Telegram. The Phase 0 spike picks the install path: user-installed app or joining the TrenchM8 server.",
      "w": 340,
      "x": 3760,
      "y": 8400
    },
